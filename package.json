{
  "name": "dsh-usage-cost",
  "version": "1.3.2",
  "description": "DeepSeek Harness plugin: token usage, estimated cost, the live peak/off-peak billing window, and account balance beside the sidebar footer.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "usage",
    "tokens",
    "cost",
    "billing",
    "sidebar"
  ],
  "author": "Wang Guo <guo_wang_113@163.com> (https://github.com/wangguo113)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangguo113/dsh-usage-cost.git"
  },
  "homepage": "https://github.com/wangguo113/dsh-usage-cost#readme",
  "bugs": {
    "url": "https://github.com/wangguo113/dsh-usage-cost/issues"
  },
  "exports": {
    ".": "./index.js",
    "./core": "./core.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "core.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test test/core.test.mjs test/host.test.mjs"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0 <0.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
